source "https://rubygems.org"

gem "jekyll", "~> 4.4"

# The classic GitHub Pages build supplied several plugins without being asked.
# A custom build gets nothing for free, so everything is declared here.
group :jekyll_plugins do
  gem "jekyll-redirect-from", "~> 0.16"
  gem "jekyll-relative-links", "~> 0.7"
  gem "jekyll-seo-tag", "~> 2.8"
  gem "jekyll-sitemap", "~> 1.4"
end

# Unbundled from the Ruby stdlib in 3.4+, still required by Jekyll's dependencies.
gem "base64"
gem "bigdecimal"
gem "csv"
gem "logger"
